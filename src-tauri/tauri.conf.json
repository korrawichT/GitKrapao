{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitKrapao",
  "mainBinaryName": "GitKrapao",
  "version": "0.4.0",
  "identifier": "local.lanes.gitgraph",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": { "script": "pnpm run web:watch", "wait": false },
    "beforeBuildCommand": "pnpm run web:build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GitKrapao",
        "width": 1320,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "maximized": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "publisher": "GitKrapao",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
